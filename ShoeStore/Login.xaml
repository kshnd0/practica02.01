<Window x:Class="ShoeStore.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/Чудо Обувь.ico"
        Title="ЧУДО-ОБУВЬ"
        Height="380" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Calibri"
        Background="{StaticResource MainBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
                <TextBlock Text="ЧУДО-ОБУВЬ"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center"/>
                
            

        
        <StackPanel Grid.Row="1" Margin="50,30,50,0">
            <TextBlock Text="Введите ваш логин:" FontSize="14" Margin="0,0,0,8"/>

            
            <TextBox x:Name="txtLogin"
                     Height="35" FontSize="14" VerticalContentAlignment="Center" Padding="5,0"
                     Margin="0,0,0,20"/>

           
            <Button x:Name="btnLog" Content="Войти"
                    Style="{StaticResource AccentButton}"
                    Height="40" Click="btnLog_Click"/>
        </StackPanel>
    </Grid>
</Window>