<Window x:Class="ShoeStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/Чудо Обувь.ico"
        Title="Каталог обуви — ЧУДО-ОБУВЬ"
        Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        FontFamily="Calibri"
        Background="{StaticResource MainBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

     
        <Border Grid.Row="0" Background="{StaticResource SecondaryBgBrush}">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

              
                <Image Grid.Column="0" Source="/Resources/Чудо Обувь.png"
                       Stretch="Uniform" Height="48" Margin="0,0,15,0"
                       VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="Каталог товаров"
                           FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center"/>

               
                <TextBlock Grid.Column="2" x:Name="txtFio"
                           FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

     
        <ListBox x:Name="lstProducts" Grid.Row="1" Margin="15,10"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch"
                 Background="Transparent" BorderThickness="0">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="CardBorder" BorderBrush="#DDD" BorderThickness="1"
                            Background="White" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>


                            <Image Grid.Column="0" Source="{Binding ImagePath}" 
                                     Stretch="Uniform" Width="100" Height="100" 
                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>


                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeaderText}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CategoryText}" FontSize="12" Foreground="Gray" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding QuantityText}" FontSize="12" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding CompositionText}" FontSize="12" Foreground="Gray" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            
                            <TextBlock Grid.Column="2" Text="{Binding PriceText}"
                                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                            <Setter TargetName="CardBorder" Property="Background" Value="#FF8080"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>